{
  "manifest_version": 3,
  "name": "Notion → Magpie",
  "version": "1.0.0",
  "description": "从当前浏览器的 Notion 登录连接到本机 Magpie。仅在你点击连接时读取 Notion 会话。",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": ["https://app.notion.com/*", "https://www.notion.so/*", "https://notion.so/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "worker.mjs", "type": "module" },
  "content_scripts": [{ "matches": ["http://127.0.0.1/connect"], "js": ["connect.js"], "run_at": "document_idle", "all_frames": false }],
  "action": { "default_title": "Notion → Magpie · 连接说明", "default_popup": "popup.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
